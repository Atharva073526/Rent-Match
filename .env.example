# ============================================================================
# RENTMATCH — MUTUAL MERIT PLATFORM
# Environment Variable Configuration (Sample / Non-secret Template)
# ============================================================================

# Application Environment Mode
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials (Optional: Platform operates in full offline/local reactive mode by default)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Aadhaar / UIDAI Sandbox Integration Point
VITE_AADHAAR_ESIGN_SANDBOX_ENDPOINT=https://sandbox.uidai.gov.in/esign/v2
VITE_AADHAAR_CLIENT_ID=rentmatch_sandbox_client

# Payment Gateway (Razorpay / Cashfree Sandbox)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_PAYMENT_MODE=simulated

# Account Aggregator (RBI Licensed AA Framework Sandbox)
VITE_ACCOUNT_AGGREGATOR_BASE_URL=https://sandbox.setu.co/aa
VITE_ACCOUNT_AGGREGATOR_CLIENT_ID=rentmatch_aa_dev

# C2PA Media Authenticity Verification Target
VITE_C2PA_VERIFIER_API=https://verify.contentauthenticity.org/api/v1/inspect
